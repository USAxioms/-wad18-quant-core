  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.1.3",
    "ts-node": "^10.9.1",
    "eslint": "^8.42.0",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">=16.0.0"
  }
